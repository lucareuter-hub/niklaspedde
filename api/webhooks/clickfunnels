// pages/api/cf-proxy.js (Next.js Pages Router-Beispiel)
export default async function handler(req, res) {
  console.log('CF webhook hit', req.method, req.url);

  // an n8n weiterleiten
  await fetch('https://n8n.niklaspedde.com/webhook/c0362d43-5fbd-472b-963f-16f82b5f6b07', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      method: req.method,
      headers: req.headers,
      body: req.body,
    }),
  });

  res.status(200).json({ ok: true });
}
